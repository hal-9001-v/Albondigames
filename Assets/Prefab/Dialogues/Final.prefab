    - target: {fileID: 7200774639924187518, guid: abc2ede2c4ae6d34584bc14c0be80fdf,
        type: 3}
      propertyPath: lines.Array.data[0]
      value: "Bueno, ya est\xE1n poniendo Fiesta Pagana"
      objectReference: {fileID: 0}
    - target: {fileID: 7200774639924187518, guid: abc2ede2c4ae6d34584bc14c0be80fdf,
        type: 3}
      propertyPath: lines.Array.data[1]
      value: "Se acab\xF3 la fiesta, voy a ir cerrando."
      objectReference: {fileID: 0}
    - target: {fileID: 7200774639924187518, guid: abc2ede2c4ae6d34584bc14c0be80fdf,
        type: 3}
      propertyPath: lines.Array.data[2]
      value: "T\xFA puedes irte a casa Mari cari\xF1o, descansa, nos vemos el finde
        que viene."
      objectReference: {fileID: 0}
    - target: {fileID: 7200774639924187518, guid: abc2ede2c4ae6d34584bc14c0be80fdf,
        type: 3}
      propertyPath: lines.Array.data[3]
